# Copy to .env, which setup and docker compose both read. These are the choices one host makes.

# The version of Agentiik, one for every image and every repository.
AGENTIIK_VERSION=v0.2.1

# The name agk and the runner reach the API at, which the certificate setup makes is issued to: a DNS name or an IPv4 address.
AGENTIIK_HOST=localhost

# The port the API serves HTTPS on, on every interface of this host.
AGENTIIK_PORT=8443

# Where the control plane keeps its database, bus, objects, keys and certificate.
AGENTIIK_DATA=/srv/agentiik

# The namespace setup creates, where workflows are pushed and run.
AGENTIIK_NAMESPACE=demo

# How many tasks the runner holds at once. Kept low, since the runner shares this host with PostgreSQL.
AGENTIIK_RUNNER_CONCURRENCY=2

# Uncomment to build the images from the agentiik source instead of pulling them: AGENTIIK_VERSION is then any tag or branch.
#COMPOSE_FILE=compose.yaml:compose.build.yaml
