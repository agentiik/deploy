# What the API and the controller both read, at the paths compose.yaml mounts. Every secret is a file.
# https://agentiik.github.io/docs/#configuration has every setting, and why each is what it is.
AGK_DATABASE_URL=postgres://agentiik@/agentiik?host=/run/postgresql
AGK_DATABASE_PASSWORD_FILE=/agentiik/database-password
# The address every runner is handed too, so the one AGENTIIK_HOST names, on the certificate.
AGK_BUS_URL=tls://${AGENTIIK_HOST}:4222
AGK_BUS_CREDENTIALS_FILE=/agentiik/bus/control-plane.creds
AGK_OBJECTS_DIR=/objects
# The certificate setup made, trusted beside the system's own authorities.
SSL_CERT_DIR=/agentiik/trust
