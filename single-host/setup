#!/usr/bin/env bash
# setup prepares this host for the single-host installation and starts it: everything compose.yaml
# mounts, the database and the bus, and the runner's identity. It reads .env, and runs as root, since
# it writes /etc/agentiik, /var/lib/agentiik and a tmpfs mount.
#
# Standard output is the operator token and nothing else, so that AGENTIIK_TOKEN="$(sudo ./setup)"
# keeps it in a shell and nowhere else; everything setup says goes to standard error. Only the
# token's hash is written down, since the token itself would be a working credential at rest.
#
# Running it again keeps every key, the bus identity, the database and the runner's identity, and
# does what is missing: after a failure, after changing AGENTIIK_VERSION (it pulls or builds,
# migrates and restarts), or to replace a lost operator token, since every run mints a new one and
# the previous one stops working.
#
# What each step mirrors is how the project's own end-to-end installation, e2e/harness.go and
# e2e/daemons.go in github.com/agentiik/agentiik, stands one up.
set -euo pipefail

exec 3>&1 1>&2

say() { printf 'setup: %s\n' "$*"; }
die() {
  printf 'setup: %s\n' "$*"
  exit 1
}

here=$(cd "$(dirname "$0")" && pwd)
cd "$here"

# The account every image runs as, the secrets tmpfs and what a runner host needs before join.
# shellcheck source=runner-host.sh
. ./runner-host.sh

# ---------------------------------------------------------------------------------------------
# What this host is, and what .env chose.

[ "$(uname -s)" = Linux ] || die "this host runs $(uname -s), and an installation runs on Linux: the runner hands the Docker daemon paths on this host to bind, which a daemon in a virtual machine, as Docker Desktop is, cannot see. agk runs anywhere and reaches the installation from there."
[ "$(id -u)" -eq 0 ] || die "run as root, sudo ./setup: it writes /etc/agentiik, /var/lib/agentiik and $0's data directory, gives them to uid $agent, and mounts a tmpfs"
case "$(uname -m)" in
x86_64 | aarch64 | arm64) ;;
*) die "this host is $(uname -m), and the images are built for x86-64 and arm64" ;;
esac
for tool in docker openssl curl sha256sum; do
  command -v "$tool" >/dev/null || die "$tool is not installed, and setup needs it"
done
docker compose version >/dev/null 2>&1 || die "the Docker Compose plugin is not installed: https://docs.docker.com/compose/install/linux/"

[ -f .env ] || die "there is no .env beside setup: cp .env.example .env, and read what it chooses"
# shellcheck source=/dev/null
. ./.env
for name in AGENTIIK_VERSION AGENTIIK_HOST AGENTIIK_PORT AGENTIIK_DATA AGENTIIK_NAMESPACE AGENTIIK_RUNNER_CONCURRENCY; do
  [ -n "${!name:-}" ] || die "$name is not set in .env, and .env.example says what it is"
done
case "$AGENTIIK_HOST" in *[!A-Za-z0-9.-]*) die "AGENTIIK_HOST is $AGENTIIK_HOST, and it is a DNS name or an IPv4 address" ;; esac
case "$AGENTIIK_PORT" in *[!0-9]*) die "AGENTIIK_PORT is $AGENTIIK_PORT, and it is a port number" ;; esac
case "$AGENTIIK_DATA" in /*) ;; *) die "AGENTIIK_DATA is $AGENTIIK_DATA, and it is an absolute path" ;; esac
case "$AGENTIIK_NAMESPACE" in *[!a-z0-9-]*) die "AGENTIIK_NAMESPACE is $AGENTIIK_NAMESPACE, and a namespace is lowercase words joined by hyphens" ;; esac
proxy=${AGENTIIK_PUBLIC_URL:-}
proxy=${proxy%/}
[ -z "$proxy" ] || [[ "$proxy" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?$ ]] ||
  die "AGENTIIK_PUBLIC_URL is $proxy, and it is the https URL of the proxy in front, a name and an optional port with no path, or empty where there is none"

data=$AGENTIIK_DATA
host=$AGENTIIK_HOST
port=$AGENTIIK_PORT

# The group that owns the Docker socket, which the runner is given and nothing else of the daemon's.
socket_gid=$(stat -c %g /var/run/docker.sock) || die "there is no Docker socket at /var/run/docker.sock, which the runner drives the daemon through"
if grep -q '^DOCKER_GID=' .env; then
  sed -i "s/^DOCKER_GID=.*/DOCKER_GID=$socket_gid/" .env
else
  printf '\n# Written by setup: the group that owns /var/run/docker.sock, which the runner is given.\nDOCKER_GID=%s\n' "$socket_gid" >>.env
fi

# Where the API listens, and the address everything else reaches it at, which every presigned URL is
# minted on. Behind a proxy, it serves plain HTTP on the loopback alone, the one hop without TLS the
# documentation allows: from a terminator, on a network nothing else reaches.
if [ -n "$proxy" ]; then
  public_url=$proxy
  printf '# Written by setup from .env: behind the proxy at AGENTIIK_PUBLIC_URL, in plain HTTP on the loopback.\nAGK_PUBLIC_URL=%s\nAGK_LISTEN=127.0.0.1:%s\n' "$public_url" "$port" >listen.env
  say "installing Agentiik $AGENTIIK_VERSION at $public_url, behind a proxy that forwards to http://127.0.0.1:$port, keeping its state in $data"
else
  public_url="https://$host:$port"
  printf '# Written by setup from .env: HTTPS on every interface, with the certificate setup makes.\nAGK_PUBLIC_URL=%s\nAGK_LISTEN=:%s\nAGK_TLS_CERT_FILE=/agentiik/tls/server.pem\nAGK_TLS_KEY_FILE=/agentiik/tls/server.key\n' "$public_url" "$port" >listen.env
  say "installing Agentiik $AGENTIIK_VERSION at $public_url, keeping its state in $data"
fi

# ---------------------------------------------------------------------------------------------
# Directories, one per service, each owned by whoever reads it and closed to everybody else:
#
#   api/          the API's keys, its certificate in tls/, the bus identity in bus/, trust/
#   controller/   the database password, the control plane's bus credential in bus/, trust/
#   nats/         the server's configuration, the bus's certificate and accounts, jetstream/
#   postgres/     the database, and socket/ where the API and the controller reach it
#   objects/      the built-in object store, shared by the API and the controller
#
# The runner's are at the paths its constants name, the same on the host and in its container, and
# /etc/agentiik/trust holds the certificate for the runner and for agk: runner-host.sh makes them,
# as it does on another machine that add-runner makes a runner.

api_dir=$data/api
controller_dir=$data/controller
nats_dir=$data/nats
install -d -m 0755 "$data" "$data/socket"
install -d -m 0700 "$nats_dir" "$nats_dir/jetstream" "$data/postgres"
install -d -m 0700 -o "$agent" -g "$agent" "$api_dir" "$api_dir/bus" "$api_dir/tls" "$controller_dir" "$controller_dir/bus" "$data/objects"
install -d -m 0755 -o "$agent" -g "$agent" "$api_dir/trust" "$controller_dir/trust"
prepare_runner_host

# ---------------------------------------------------------------------------------------------
# The certificate. The bus serves TLS with it on 4222, and so does the API where no proxy is in
# front; setup makes it and signs it itself. Clients trust that one certificate, as
# /etc/agentiik/trust/agentiik.pem, rather than an authority that could sign others. A certificate
# from an authority clients already trust replaces api/tls/server.pem and api/tls/server.key, and
# the trust directories then hold that authority, or nothing where the system's own roots include it.
# Behind a proxy, the API is reached with the proxy's certificate, and the bus still with this one,
# since the bus is not proxied: it is NATS, not HTTP.

san="DNS:localhost,IP:127.0.0.1"
case "$host" in
localhost | 127.0.0.1) ;;
*[!0-9.]*) san="DNS:$host,$san" ;;
*) san="IP:$host,$san" ;;
esac
if [ -f "$api_dir/tls/server.pem" ] && ! openssl x509 -in "$api_dir/tls/server.pem" -noout -ext subjectAltName 2>/dev/null | grep -Eq "(DNS|IP Address):$host(,|\$)"; then
  say "the certificate in $api_dir/tls is not issued to $host, so a new one replaces it: every client trusts the new /etc/agentiik/trust/agentiik.pem"
  rm -f "$api_dir/tls/server.pem" "$api_dir/tls/server.key"
fi
if [ ! -f "$api_dir/tls/server.pem" ]; then
  config=$(mktemp)
  cat >"$config" <<EOF
[req]
distinguished_name = dn
x509_extensions = ext
prompt = no
[dn]
CN = $host
[ext]
subjectAltName = $san
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = serverAuth
EOF
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 825 \
    -config "$config" -keyout "$api_dir/tls/server.key" -out "$api_dir/tls/server.pem" 2>/dev/null
  rm -f "$config"
  say "made a certificate for $san, valid 825 days"
fi
chown "$agent:$agent" "$api_dir/tls/server.pem" "$api_dir/tls/server.key"
chmod 0644 "$api_dir/tls/server.pem"
chmod 0600 "$api_dir/tls/server.key"
for trust in "$api_dir/trust" "$controller_dir/trust" /etc/agentiik/trust; do
  install -m 0644 "$api_dir/tls/server.pem" "$trust/agentiik.pem"
done
# NATS runs as root and reads its own copies.
install -m 0644 "$api_dir/tls/server.pem" "$nats_dir/server.pem"
install -m 0600 "$api_dir/tls/server.key" "$nats_dir/server.key"

# ---------------------------------------------------------------------------------------------
# Keys and passwords, each in a file its owner alone can read, since every program refuses a secret
# anybody else can.

secret_file() { # path owner command...: writes what command prints, once
  local path=$1 owner=$2
  shift 2
  if [ ! -s "$path" ]; then
    (umask 077 && "$@" >"$path")
  fi
  chown "$owner" "$path"
  chmod 0600 "$path"
}
master_key() { printf 'id: %s\nkey: %s\n' "$(date -u +%Y-%m)" "$(openssl rand -base64 32)"; }
secret_file "$api_dir/database-password" "$agent" openssl rand -hex 32
install -m 0600 -o "$agent" -g "$agent" "$api_dir/database-password" "$controller_dir/database-password"
secret_file "$api_dir/presign-key" "$agent" openssl rand -base64 32
secret_file "$api_dir/master-key" "$agent" master_key

token="agk_op_$(openssl rand -hex 24)"
(umask 077 && printf %s "$token" | sha256sum | cut -d' ' -f1 >"$api_dir/operator-token.sha256")
chown "$agent:$agent" "$api_dir/operator-token.sha256"
say "wrote the master key, the presign key, the database password and a new operator token's hash"


# ---------------------------------------------------------------------------------------------
# The images: pulled from ghcr.io, or built from source where compose.build.yaml is in COMPOSE_FILE.

say "pulling the images$(docker compose config --format json | grep -q '"build"' && echo ", and building the api, controller and runner images from source, which takes a few minutes")"
docker compose pull --quiet --ignore-buildable
docker compose build --quiet

# ---------------------------------------------------------------------------------------------
# The bus: its identity, written once by bus-init, and the server's configuration beside it.

if [ ! -f "$api_dir/bus/accounts.conf" ]; then
  docker compose run --rm --no-deps api bus-init /agentiik/bus
fi
# The accounts for the server, and the control plane's credential for the controller, which is also
# how a credential bus-credential renewed reaches the controller: run setup again.
install -m 0600 "$api_dir/bus/accounts.conf" "$nats_dir/accounts.conf"
install -m 0600 -o "$agent" -g "$agent" "$api_dir/bus/control-plane.creds" "$controller_dir/bus/control-plane.creds"
cat >"$nats_dir/nats.conf" <<EOF
# Written by setup. The bus listens on every interface, since a runner on another machine reaches it
# at AGENTIIK_HOST as the API and the controller do, and always over TLS, with a credential the API
# mints: it is never reached in plaintext. Its health check stays on the loopback.
listen: "0.0.0.0:4222"
http: "127.0.0.1:8222"
tls {
  cert_file: "/nats/server.pem"
  key_file: "/nats/server.key"
}
jetstream {
  store_dir: "/nats/jetstream"
}
include "accounts.conf"
EOF
chmod 0644 "$nats_dir/nats.conf"

# ---------------------------------------------------------------------------------------------
# The database: migrated as its superuser, which creates the role the API and the controller
# connect as, then the namespace workflows are pushed and run in, which is left as it is when it exists.

docker compose up --detach --wait --wait-timeout 180 postgres nats
docker compose run --rm --no-deps \
  -e AGK_MIGRATE_DATABASE_URL='postgres://postgres@/agentiik?host=/run/postgresql' \
  api migrate

docker compose run --rm --no-deps api namespace create "$AGENTIIK_NAMESPACE"

# ---------------------------------------------------------------------------------------------
# The API and the controller, recreated so that the API reads the new token's hash.

docker compose up --detach --wait --wait-timeout 180 --force-recreate api controller

# One request as the operator, to the API on this host whatever its name resolves to, and past the
# proxy where there is one, on the loopback, so that what fails here is the API rather than the proxy.
if [ -n "$proxy" ]; then
  local_url="http://127.0.0.1:$port" reach=()
else
  local_url=$public_url reach=(--cacert /etc/agentiik/trust/agentiik.pem --resolve "$host:$port:127.0.0.1")
fi
api() { # method path [body]
  local body=()
  [ $# -lt 3 ] || body=(-H 'Content-Type: application/json' --data "$3")
  # The token goes through standard input rather than an argument, which anybody on the host can read.
  printf 'header = "Authorization: Bearer %s"\n' "$token" |
    curl --config - --silent --show-error --fail-with-body "${reach[@]}" -X "$1" "${body[@]}" "$local_url$2"
}
for _ in $(seq 60); do
  api GET /api/v1/runner-pools >/dev/null 2>&1 && break
  sleep 2
done
api GET /api/v1/runner-pools >/dev/null || die "the API did not answer at $local_url: docker compose logs api says why"
say "the API answers at $local_url"

# ---------------------------------------------------------------------------------------------
# The runner: a join token from the default pool, where every step that names no runs_on goes, with
# no label, traded by join, as root, for the runner's identity
# in /etc/agentiik/runner.env and its key in /var/lib/agentiik/runner.key, both given to $agent.

if [ ! -s /etc/agentiik/runner.env ]; then
  issued=$(api POST /api/v1/runner-pools/default/join-tokens '{}')
  join_token=$(printf '%s' "$issued" | sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p')
  [ -n "$join_token" ] || die "the API issued no join token: $issued"
  # Through the proxy where there is one, as a runner on another machine does.
  docker compose run --rm --no-deps --user 0:0 runner join --api "$public_url" --token "$join_token" ||
    die "the runner could not join at $public_url$([ -z "$proxy" ] || echo ": the proxy must be serving it, with a certificate the system trusts or one in /etc/agentiik/trust")"
fi

joined=$(sed -n 's/^AGK_API=//p' /etc/agentiik/runner.env | tr -d '"')
[ -z "$joined" ] || [ "$joined" = "$public_url" ] ||
  say "the runner joined at $joined, not $public_url, and keeps reaching the API there: sudo rm /etc/agentiik/runner.env and run setup again to join it at the new address"

docker compose up --detach --wait --wait-timeout 180
for _ in $(seq 60); do
  api GET /api/v1/runners 2>/dev/null | grep -Eq '"reported_state" *: *"ready"' && break
  sleep 2
done
api GET /api/v1/runners | grep -Eq '"reported_state" *: *"ready"' || die "the runner has not reported ready: docker compose logs runner says why"
say "the runner is ready"

if [ -n "$proxy" ]; then
  say "Agentiik $AGENTIIK_VERSION is running at $public_url. Runners trust /etc/agentiik/trust/agentiik.pem for the bus, and the proxy's certificate for the API."
else
  say "Agentiik $AGENTIIK_VERSION is running at $public_url. Clients trust /etc/agentiik/trust/agentiik.pem."
fi
if [ -t 3 ]; then
  say "the operator token follows, shown this once: keep it, since only its hash is written down"
fi
printf '%s\n' "$token" >&3
